# 拷贝成 .env 并 source，或直接 export
# 千万不要把真实值提交进 git

# qBittorrent WebUI 密码
JAVPIPE_QB_PASSWORD=

# 境外站点代理（MissAV / Jable 基本都需要）
JAVPIPE_PROXY=

# 想用磁力就填一个 bitmagnet GraphQL 网关
JAVPIPE_BITMAGNET=

# 路径覆盖（不想改 config.yaml 时用）
# JAVPIPE_DOWNLOAD_ROOT=/volume1/downloads/jav
# JAVPIPE_FAILED_ROOT=/volume1/downloads/jav-failed
# JAVPIPE_LIBRARY_ROOT=/volume1/media/jav
